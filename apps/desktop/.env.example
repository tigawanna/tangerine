# Client (Deno Desktop webview) — VITE_ prefixed
VITE_APP_URL=http://localhost:3070
# Auth + data API (apps/api). OAuth secrets live here — not in the desktop binary.
VITE_API_URL=http://localhost:5000
# Deno preload also reads this for token exchange. Must be the API, not :3070.
BETTER_AUTH_URL=http://localhost:5000
# System-browser sign-in page (apps/web). Desktop opens this with PKCE + loopback.
VITE_SIGN_IN_URL=http://localhost:3064/auth
# Stable OAuth loopback (default 17832). Random ports break after HMR / re-sign-in.
# DESKTOP_AUTH_LOOPBACK_PORT=17832

# Embedded Turso / libSQL (vector-capable). Defaults to ~/.config/tangerine-desktop/tangerine.db
# Use `file:…` locally or `libsql://…` + DATABASE_AUTH_TOKEN for remote Turso.
# Do NOT point this at better-sqlite3 — F32_BLOB vectors require libSQL.
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# PostHog product analytics (optional)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
