# Client (browser) — must be prefixed with VITE_
# Local: http://localhost:3064
# Vercel: set both to your deployment URL (e.g. https://tangerine.vercel.app)
VITE_APP_URL=http://localhost:3064
VITE_API_URL=http://localhost:3064

# PostHog product analytics (optional — omit locally to disable)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server runtime (local dev + Vercel Project → Settings → Environment Variables)
ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=generate-a-32-char-secret
# Must match the public site origin (no trailing slash)
BETTER_AUTH_URL=http://localhost:3064
# Comma-separated allowed origins (include preview + production URLs on Vercel)
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3064

# GitHub OAuth App — callback {BETTER_AUTH_URL}/api/auth/callback/github
# Add the same callback for each Vercel production / preview URL you use
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback when no signed-in GitHub session is available
# GH_PAT=
