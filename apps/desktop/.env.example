# Client (browser / Deno Desktop webview) — must be prefixed with VITE_
# Desktop HMR uses port 3065. Keep these identical to BETTER_AUTH_URL.
VITE_APP_URL=http://localhost:3065
VITE_API_URL=http://localhost:3065

# PostHog product analytics (optional — omit locally to disable)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server runtime
ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=generate-a-32-char-secret
# Must match the origin the desktop window actually loads (no trailing slash)
BETTER_AUTH_URL=http://localhost:3065
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3065

# GitHub OAuth App (https://github.com/settings/developers)
# Authorization callback URL MUST be exactly:
#   http://localhost:3065/api/auth/callback/github
# OAuth Apps allow one callback URL — use a separate app for desktop vs web (3064),
# or temporarily point this app at 3065 while testing desktop.
# Homepage URL can be http://localhost:3065
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback when no signed-in GitHub session is available
# GH_PAT=
