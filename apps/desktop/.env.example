# Client (browser / Deno Desktop webview) — must be prefixed with VITE_
# Local Deno Desktop + browser `pnpm dev` use port 3065 (web app stays on 3064).
VITE_APP_URL=http://localhost:3065
# Same-origin while TanStack Start still hosts `/api/auth`. Point at the Hono API when cutting over:
# VITE_API_URL=http://localhost:5000
VITE_API_URL=http://localhost:3065

# PostHog product analytics (optional — omit locally to disable)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server runtime
ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=generate-a-32-char-secret
# Must match the public site origin (no trailing slash)
BETTER_AUTH_URL=http://localhost:3065
# Comma-separated allowed origins
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3065

# GitHub OAuth App — callback {BETTER_AUTH_URL}/api/auth/callback/github
# Use a separate OAuth app from apps/web if web still uses :3064
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback when no signed-in GitHub session is available
# GH_PAT=
