# Server
PORT=5000
NODE_ENV=development

# Turso / libsql — local file or remote (Vercel: libsql://… + DATABASE_AUTH_TOKEN)
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Better Auth (GitHub OAuth — no email/password)
# Vercel: BETTER_AUTH_URL = this API’s public origin (e.g. https://….vercel.app)
BETTER_AUTH_SECRET=generate-a-32-char-secret
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3064,http://localhost:3070,http://localhost:5000,com.tigawanna.tangerine:/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_EMAIL=

# CORS / frontend (Vercel: prod web origin; include it in BETTER_AUTH_TRUSTED_ORIGINS too)
FRONTEND_URL=http://localhost:3064
