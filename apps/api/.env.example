# Server
PORT=5000
NODE_ENV=development

# Turso / libsql — local file or remote (Vercel: libsql://… + DATABASE_AUTH_TOKEN)
DATABASE_URL=file:local.db
# DATABASE_AUTH_TOKEN=

# Better Auth (GitHub OAuth — no email/password)
# BETTER_AUTH_URL = public *web* origin (apps/web proxies /api/auth → this API).
# Local: http://localhost:3064 · Vercel: https://tangerine-dev.vercel.app
# GitHub callback: {BETTER_AUTH_URL}/api/auth/callback/github
# Full ops notes: docs/vercel-deploy.md
BETTER_AUTH_SECRET=generate-a-32-char-secret
BETTER_AUTH_URL=http://localhost:3064
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3064,http://localhost:3070,http://localhost:5000,com.tigawanna.tangerine:/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_EMAIL=

# CORS / frontend (must match BETTER_AUTH_URL / web origin)
FRONTEND_URL=http://localhost:3064
