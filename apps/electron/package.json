{
  "name": "electron",
  "version": "0.0.1",
  "private": true,
  "description": "Tangerine desktop (Electron + Better Auth)",
  "main": "./out/main/index.js",
  "author": "tigawanna",
  "homepage": "https://github.com/tigawanna/tangerine",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm check-types && electron-vite build",
    "check-types": "pnpm typecheck:node && pnpm typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "build:unpack": "pnpm build && electron-builder --dir",
    "build:linux": "pnpm build && electron-builder --linux",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "pnpm build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@better-auth/electron": "1.7.3",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@repo/auth": "workspace:*",
    "better-auth": "1.7.3",
    "conf": "^15.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "catalog:",
    "vite": "^7.2.6"
  }
}
