# Client (browser) — VITE_ prefixed
VITE_APP_URL=http://localhost:3064
# Upstream apps/api (Nitro proxies same-origin /api/* → here)
VITE_API_URL=http://localhost:5000

# PostHog (optional)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: public/landing GitHub loads without a signed-in user
# GH_PAT=

# Auth secrets (BETTER_AUTH_*, GITHUB_CLIENT_*) belong in apps/api/.env only.
# GitHub OAuth callback must be the *web* origin (proxied): http://localhost:3064/api/auth/callback/github
# Ops: docs/vercel-deploy.md (proxy + Turso + Hono on Vercel)
