# Client (browser) — must be prefixed with VITE_
VITE_APP_URL=http://localhost:3064
VITE_API_URL=http://localhost:3064

# PostHog product analytics (optional — omit locally to disable)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server runtime (local dev + Vercel env vars)
ADMIN_EMAIL=you@example.com
BETTER_AUTH_SECRET=generate-a-32-char-secret
BETTER_AUTH_URL=http://localhost:3064
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3064

# GitHub OAuth App — callback {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional fallback when no signed-in GitHub session is available
# GH_PAT=
