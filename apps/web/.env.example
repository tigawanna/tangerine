# Client (browser) — VITE_ prefixed
VITE_APP_URL=http://localhost:3064
# Better Auth + Hono live on apps/api (no local /api/auth on web)
VITE_API_URL=http://localhost:5000

# PostHog (optional)
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Optional: public/landing GitHub loads without a signed-in user
# GH_PAT=

# Auth secrets (BETTER_AUTH_*, GITHUB_CLIENT_*) belong in apps/api/.env only.
# GitHub OAuth callback: http://localhost:5000/api/auth/callback/github
