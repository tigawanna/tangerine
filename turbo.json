{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "LOG_LEVEL",
    "LOG_DEBUG",
    "DB_LOG_LEVEL",
    "DATABASE_URL",
    "DATABASE_AUTH_TOKEN",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_TRUSTED_ORIGINS",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "ADMIN_EMAIL",
    "FRONTEND_URL",
    "CRUD_BEARER_TOKEN",
    "CRON_SECRET",
    "GH_PAT",
    "VITE_API_URL",
    "VITE_APP_URL",
    "VITE_SIGN_IN_URL",
    "VITE_POSTHOG_KEY",
    "VITE_POSTHOG_HOST",
    "OPENAI_API_KEY",
    "OPENROUTER_API_KEY",
    "EVLOG_FS_DIR",
    "DESKTOP_AUTH_LOOPBACK_PORT",
    "QUEUE_DATABASE_PATH",
    "QUEUE_DATABASE_URL",
    "GEMMA_MODEL_PATH",
    "GEMMA_DTYPE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".output/**", ".vercel/output/**", "dist/**"]
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "//#quality": {
      "dependsOn": ["//#lint", "//#format"]
    },
    "//#quality:fix": {
      "dependsOn": ["//#lint:fix", "//#format:fix"],
      "cache": false
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
