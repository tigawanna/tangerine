public-hoist-pattern[]=*onnxruntime*
public-hoist-pattern[]=*onnxruntime-common*
# Hoist Next so Turbopack can resolve it from the monorepo root (apps/web sets
# turbopack.root there for @repo/* packages). Only one Next app remains in the
# workspace after excluding apps/legacy-next.
public-hoist-pattern[]=next
